<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             mc:Ignorable="d"
             x:Class="MarkMello.Presentation.Views.AppExportPanelView"
             x:DataType="vm:MainWindowViewModel">
  <Border Classes="mm-settings-panel mm-popover-left mm-app-export-panel"
          Width="320">
    <StackPanel>
      <Border Classes="mm-settings-head-shell">
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
          <Button Grid.Column="0"
                  Classes="mm-settings-close"
                  Command="{Binding ReturnToAppMenuCommand}"
                  ToolTip.Tip="{Binding OverlayBackToMenu}">
            <Path Data="M9.5,1.5 L2.5,5.5 L9.5,9.5"
                  Stroke="{DynamicResource MmTextFaintBrush}"
                  StrokeThickness="1.4"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Fill="Transparent" />
          </Button>
          <TextBlock Grid.Column="1"
                     Classes="mm-settings-title"
                     VerticalAlignment="Center"
                     Text="{Binding AppExportHeader}" />
          <Button Grid.Column="2"
                  Classes="mm-settings-close"
                  Command="{Binding CloseOverlayCommand}"
                  ToolTip.Tip="{Binding OverlayCloseExport}">
            <Path Data="M0,0 L10,10 M10,0 L0,10"
                  Stroke="{DynamicResource MmTextFaintBrush}"
                  StrokeThickness="1.4"
                  StrokeLineCap="Round" />
          </Button>
        </Grid>
      </Border>

      <Border Classes="mm-settings-body-shell">
        <StackPanel Spacing="0">
          <!-- The export barrier waits on the renderer with no deadline, so the
               user is its only bound. This row is that bound: while an export is
               in flight it replaces the export actions (which are disabled
               anyway) with the one action that can still make progress. It is
               NOT shown otherwise, so a fast export never flashes it. -->
          <Button Classes="mm-menu-item"
                  IsVisible="{Binding IsExportBusy}"
                  AutomationProperties.Name="{Binding ExportCancelLabel}"
                  Command="{Binding CancelExportCommand}">
            <StackPanel Spacing="2"
                        HorizontalAlignment="Left">
              <TextBlock Classes="mm-setting-label"
                         Text="{Binding ExportCancelLabel}" />
              <TextBlock Classes="mm-setting-hint"
                         Text="{Binding ExportCancelHint}" />
            </StackPanel>
          </Button>

          <Button Classes="mm-menu-item"
                  IsVisible="{Binding !IsExportBusy}"
                  AutomationProperties.Name="{Binding ExportPdfLabel}"
                  Command="{Binding ExportPdfCommand}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <StackPanel Grid.Column="0"
                          Spacing="2"
                          HorizontalAlignment="Left">
                <TextBlock Classes="mm-setting-label"
                           Text="{Binding ExportPdfLabel}" />
                <TextBlock Classes="mm-setting-hint"
                           Text="{Binding ExportPdfHint}" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Classes="mm-setting-meta"
                         Text="PDF" />
            </Grid>
          </Button>

          <Line Classes="mm-setting-divider"
                IsVisible="{Binding !IsExportBusy}"
                StartPoint="0,0.5"
                EndPoint="1,0.5" />

          <Button Classes="mm-menu-item"
                  IsVisible="{Binding !IsExportBusy}"
                  AutomationProperties.Name="{Binding ExportHtmlLabel}"
                  Command="{Binding ExportHtmlCommand}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <StackPanel Grid.Column="0"
                          Spacing="2"
                          HorizontalAlignment="Left">
                <TextBlock Classes="mm-setting-label"
                           Text="{Binding ExportHtmlLabel}" />
                <TextBlock Classes="mm-setting-hint"
                           Text="{Binding ExportHtmlHint}" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Classes="mm-setting-meta"
                         Text="HTML" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
